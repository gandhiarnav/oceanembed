# Copernicus Marine Service (GLORYS 3D Target & Surface Inputs)
# Register at: https://marine.copernicus.eu
COPERNICUSMARINE_SERVICE_USERNAME=your_copernicus_username
COPERNICUSMARINE_SERVICE_PASSWORD=your_copernicus_password

# NASA Earthdata (SMAP SSS & PO.DAAC CMC SST)
# Register at: https://urs.earthdata.nasa.gov
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

# ECMWF Climate Data Store (ERA5 Surface Winds)
# Register at: https://cds.climate.copernicus.eu
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=your_cds_api_key
